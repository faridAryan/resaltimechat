{
  "name": "learno-backend-serverless",
  "version": "3.0.0",
  "description": "Learno Language Learning Platform - AWS Serverless Backend with LangChain v1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "langchain",
    "aws-lambda",
    "serverless",
    "typescript",
    "language-learning"
