{
  "name": "learno-backend-serverless",
  "version": "5.0.0",
  "description": "Learno Language Learning Platform - AI-Powered with RL Curriculum, Voice Interaction, Knex ORM",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run"
  },
  "keywords": [
    "langchain",
    "aws-lambda",
    "serverless",
    "typescript",
    "language-learning",
    "aurora",
    "milvus",
    "vector-database",
    "reinforcement-learning",
    "voice-recognition",
    "real-time-voice",
    "gemini-2.5-flash",
    "native-audio",
    "google-ai"
  ],
  "author": "Learno Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-sqs": "^3.490.0",
    "@aws-sdk/client-eventbridge": "^3.490.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.490.0",
    "@aws-sdk/client-rds-data": "^3.490.0",
    "@aws-sdk/client-secrets-manager": "^3.490.0",
    "@google/generative-ai": "^0.21.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@langchain/core": "^0.1.5",
    "@langchain/openai": "^0.0.14",
    "@langchain/community": "^0.0.20",
    "langchain": "^0.1.5",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "@zilliz/milvus2-sdk-node": "^2.3.4",
    "ioredis": "^5.3.2",
    "aws-lambda": "^1.0.7",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "date-fns": "^3.0.6",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "aws-cdk": "^2.117.0",
    "aws-cdk-lib": "^2.117.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
